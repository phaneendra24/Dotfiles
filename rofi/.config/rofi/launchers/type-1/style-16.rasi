/**
 *
 * Custom launcher theme for the storm anime desktop
 *
 **/

configuration {
    modi:                       "drun,run,filebrowser";
    show-icons:                 true;
    display-drun:               "󰀻 Apps";
    display-run:                " Run";
    display-filebrowser:        " Files";
    display-window:             " Windows";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c}";
}

@import "shared/colors.rasi"
@import "shared/fonts.rasi"

* {
    border-colour:               #8af4d06f;
    handle-colour:               #ccf4d06f;
    background-colour:           transparent;
    foreground-colour:           #f5efdf;
    alternate-background:        #de101216;
    normal-background:           transparent;
    normal-foreground:           #f5efdf;
    urgent-background:           #9d3a2d;
    urgent-foreground:           #fff4ef;
    active-background:           #425133;
    active-foreground:           #f6eedb;
    selected-normal-background:  #f4d06f;
    selected-normal-foreground:  #15120f;
    alternate-normal-background: transparent;
    alternate-normal-foreground: #f3ead7;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       760px;
    border:                      1px;
    border-radius:               28px;
    border-color:                @border-colour;
    background-color:            #e108090c;
    background-image:            linear-gradient(180, rgba(255,255,255,0.10), rgba(255,255,255,0.02));
}

mainbox {
    spacing:                     18px;
    padding:                     30px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    spacing:                     16px;
    padding:                     20px 24px;
    border:                      1px;
    border-radius:               22px;
    border-color:                #66fff1ca;
    background-color:            #ef181b21;
    children:                    [ "prompt", "entry" ];
}

prompt {
    background-color:            transparent;
    text-color:                  #f4d06f;
    font:                        "JetBrains Mono Nerd Font Bold 13";
    str:                         "";
}

entry {
    background-color:            transparent;
    text-color:                  #fff8ea;
    placeholder:                 "Search apps";
    placeholder-color:           #bcae92;
}

listview {
    columns:                     1;
    lines:                       8;
    cycle:                       true;
    dynamic:                     true;
    fixed-height:                true;
    scrollbar:                   true;
    spacing:                     12px;
    background-color:            transparent;
}

scrollbar {
    handle-width:                6px;
    handle-color:                @handle-colour;
    border-radius:               10px;
    background-color:            #40121318;
}

element {
    spacing:                     14px;
    padding:                     16px 18px;
    border:                      1px;
    border-radius:               20px;
    border-color:                #26ffffff;
    background-color:            #c913151a;
    text-color:                  @foreground-colour;
}

element selected.normal {
    background-color:            #f4d06f;
    text-color:                  #15120f;
    border-color:                #fff4d4;
}

element-icon {
    size:                        28px;
    background-color:            transparent;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
}

mode-switcher {
    spacing:                     10px;
    background-color:            transparent;
}

button {
    padding:                     10px 14px;
    border:                      1px;
    border-radius:               14px;
    border-color:                #20ffffff;
    background-color:            #96111216;
    text-color:                  #d8ccb4;
}

button selected {
    background-color:            #3b2b11;
    text-color:                  #f4d06f;
    border-color:                #8af4d06f;
}
