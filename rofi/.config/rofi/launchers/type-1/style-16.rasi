/**
 * ╔══════════════════════════════════════════════════════════════════╗
 * ║  Rofi Launcher — Hyprland Tokyo Night Glassmorphism              ║
 * ║  Theme: Sapphire / Lavender / Cyan (No yellow / gold)           ║
 * ╚══════════════════════════════════════════════════════════════════╝
 **/

configuration {
    modi:                       "drun,run,window,filebrowser";
    show-icons:                 true;
    display-drun:               "󰀻 Apps";
    display-run:                " Run";
    display-window:             " Windows";
    display-filebrowser:        " Files";
    drun-display-format:        "{name}";
    window-format:              "{w} · {c} · {t}";
}

* {
    font:                        "FiraCode Nerd Font 11";
    background-color:            transparent;
    text-color:                  #c0caf5;
    margin:                      0;
    padding:                     0;
    spacing:                     0;
}

window {
    transparency:                "real";
    location:                    center;
    anchor:                      center;
    fullscreen:                  false;
    width:                       680px;
    border:                      1px;
    border-radius:               18px;
    border-color:                rgba(122, 162, 247, 0.35);
    background-color:            rgba(15, 17, 26, 0.72);
}

mainbox {
    spacing:                     14px;
    padding:                     24px;
    background-color:            transparent;
    children:                    [ "inputbar", "listview", "mode-switcher" ];
}

inputbar {
    spacing:                     12px;
    padding:                     12px 18px;
    border:                      1px;
    border-radius:               12px;
    border-color:                rgba(122, 162, 247, 0.22);
    background-color:            rgba(26, 29, 45, 0.65);
    children:                    [ "prompt", "entry" ];
}

prompt {
    text-color:                  #7dcfff;
    font:                        "FiraCode Nerd Font Bold 12";
    vertical-align:              0.5;
}

entry {
    text-color:                  #c0caf5;
    placeholder:                 "Search applications or commands...";
    placeholder-color:           rgba(154, 165, 206, 0.45);
    vertical-align:              0.5;
}

listview {
    columns:                     1;
    lines:                       7;
    cycle:                       true;
    dynamic:                     true;
    scrollbar:                   false;
    spacing:                     6px;
    background-color:            transparent;
}

element {
    spacing:                     14px;
    padding:                     10px 14px;
    border:                      1px;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            transparent;
    text-color:                  #a9b1d6;
}

element selected.normal {
    background-color:            rgba(122, 162, 247, 0.18);
    text-color:                  #7dcfff;
    border-color:                rgba(122, 162, 247, 0.45);
}

element selected.active {
    background-color:            rgba(187, 154, 247, 0.22);
    text-color:                  #bb9af7;
    border-color:                rgba(187, 154, 247, 0.45);
}

element selected.urgent {
    background-color:            rgba(247, 118, 142, 0.25);
    text-color:                  #f7768e;
    border-color:                rgba(247, 118, 142, 0.50);
}

element-icon {
    size:                        28px;
    background-color:            transparent;
    vertical-align:              0.5;
}

element-text {
    background-color:            transparent;
    text-color:                  inherit;
    vertical-align:              0.5;
    font:                        "FiraCode Nerd Font 11";
}

mode-switcher {
    spacing:                     8px;
    background-color:            transparent;
}

button {
    padding:                     7px 12px;
    border:                      1px;
    border-radius:               10px;
    border-color:                transparent;
    background-color:            rgba(26, 29, 45, 0.40);
    text-color:                  #565f89;
    font:                        "FiraCode Nerd Font 10";
}

button selected {
    background-color:            rgba(122, 162, 247, 0.18);
    text-color:                  #7dcfff;
    border-color:                rgba(122, 162, 247, 0.35);
}
